# ==============================================================================
# OpenMRS 3.x (O3) Environment Configuration Template (.env.example)
# ==============================================================================
COMPOSE_PROJECT_NAME=oncopenmrs
O3_TAG=qa
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
SERVER_NAME=localhost
ADMIN_EMAIL=admin@example.com

# MariaDB / MySQL Database Configuration
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs_user
MYSQL_PASSWORD=CHANGE_ME_TO_A_SECURE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_SECURE_ROOT_PASSWORD

# Backup & Disaster Recovery Configuration
GCS_BUCKET_NAME=openmrs-gcp-pilot-backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_TO_A_SECURE_BACKUP_PASSPHRASE
LOCAL_BACKUP_DIR=/var/backups/openmrs
CONTAINER_DB_NAME=openmrs-db
