# ==============================================================================
# OpenMRS GCP Pilot — Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT commit the real '.env' file to version control.
# Copy this file to '.env' and update the placeholder values with secure credentials.
# You can generate strong random passwords using: ./scripts/generate-secrets.sh
# ==============================================================================

# Project & Host Port Configuration (Change HOST_HTTP_PORT if port 80 is occupied locally)
COMPOSE_PROJECT_NAME=oncopenmrs
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
SERVER_NAME=localhost
ADMIN_EMAIL=admin@example.com

# MariaDB / MySQL Database Configuration
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs_user
MYSQL_PASSWORD=CHANGE_ME_TO_A_SECURE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_SECURE_ROOT_PASSWORD

# OpenMRS Application Directives
OPENMRS_AUTO_UPDATE_DATABASE=true
OPENMRS_CREATE_TABLES=true

# Backup & Disaster Recovery Configuration
GCS_BUCKET_NAME=openmrs-gcp-pilot-backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_TO_A_SECURE_BACKUP_PASSPHRASE
LOCAL_BACKUP_DIR=/var/backups/openmrs
CONTAINER_DB_NAME=openmrs-db
